# Database used by the FastAPI backend and ETL pipeline.
DATABASE_URL=

# Frontend URL allowed by backend CORS in local/dev deployments.
FRONTEND_ORIGIN=http://localhost:5173

# SurveyCTO connection. Use only the SurveyCTO server/subdomain, not the full URL.
SURVEYCTO_SERVER=
SURVEYCTO_MAIN_FORM_ID=Season_survey
SURVEYCTO_SPREAD_FORM_ID=BHT_3_Category_Survey_Spread_Wave_1
SURVEYCTO_EDIBLE_OIL_FORM_ID=BHT_3_Category_Survey_Edible_oil_Wave_1
SURVEYCTO_BREAKFAST_CEREAL_FORM_ID=BHT_3_Category_Survey_Breakfast_wave_1
SURVEYCTO_SPREAD_XLSFORM=data/category_xlsforms/BHT_3_Categories_Margarine_Wave_1_Updated_Script.xlsx
SURVEYCTO_EDIBLE_OIL_XLSFORM=data/category_xlsforms/BHT_3_Categories_Edible_Oil_Wave_1_Updated_Script.xlsx
SURVEYCTO_BREAKFAST_CEREAL_XLSFORM=data/category_xlsforms/BHT_3_Categories_Breakfast_Cereal_Wave_1_Updated_Script.xlsx
SURVEYCTO_USERNAME=
SURVEYCTO_PASSWORD=

# Only submissions from these SurveyCTO form definition versions appear on the dashboard.
# Supply one version or multiple comma-separated versions, e.g. 2608060937,2608060938.
MAIN_SURVEY_FORMDEF_VERSION=

# Optional main survey dictionary workbook path, relative to the project root.
SURVEYCTO_MAIN_DICTIONARY=data/monthly_xlsform_dictionary/BHT+4+SEASONS+JULY+2026.xlsx

# Background worker sync controls.
AUTO_SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=3600

# Export regeneration can stay disabled for the main-only worker unless reintroduced later.
AUTO_EXPORT_ENABLED=false
EXPORT_REGEN_INTERVAL_SECONDS=86400

# Shared machine-to-machine secret used only by the BHT dashboard integration.
QC_INTEGRATION_API_KEY=

# Fresh databases auto-create the initial Superadmin from backend defaults:
# username: superadmin
# password: inicio2026
